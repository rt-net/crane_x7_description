<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="material_gazebo_black">
    <visual>
      <material>
        <ambient>0.2 0.2 0.2 1</ambient>
        <diffuse>0.0 0.0 0.0 1</diffuse>
      </material>
    </visual>
  </xacro:macro>

  <xacro:macro name="material_gazebo_white">
    <visual>
      <material>
        <ambient>0.95 0.95 0.95 1</ambient>
        <diffuse>0.95 0.95 0.95 1</diffuse>
      </material>
    </visual>
  </xacro:macro>

  <xacro:macro name="material_gazebo_red">
    <visual>
      <material>
        <ambient>1.0 0.3 0.3 1</ambient>
        <diffuse>1.0 0.0 0.0 1</diffuse>
      </material>
    </visual>
  </xacro:macro>

  <xacro:macro name="gazebo_robot_settings"
    params="config_package
            config_file_path
            ">

    <gazebo>
      <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find ${config_package})/${config_file_path}</parameters>
      </plugin>
    </gazebo>

    <gazebo reference="crane_x7_mounting_plate_link">
      <xacro:material_gazebo_black/>
    </gazebo>

    <gazebo reference="crane_x7_shoulder_fixed_part_link">
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="crane_x7_shoulder_revolute_part_link">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="crane_x7_upper_arm_fixed_part_link">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="crane_x7_upper_arm_revolute_part_link">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="crane_x7_lower_arm_fixed_part_link">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="crane_x7_lower_arm_revolute_part_link">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="crane_x7_wrist_link">
      <xacro:material_gazebo_white/>
    </gazebo>

    <gazebo reference="crane_x7_upper_arm_fixed_part_joint_cover_l_link">
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="crane_x7_upper_arm_fixed_part_joint_cover_r_link">
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="crane_x7_lower_arm_fixed_part_joint_cover_l_link">
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="crane_x7_lower_arm_fixed_part_joint_cover_r_link">
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="crane_x7_lower_arm_revolute_part_logo_symbol_l_link">
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="crane_x7_lower_arm_revolute_part_logo_symbol_r_link">
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="crane_x7_lower_arm_revolute_part_logo_text_l_link">
      <xacro:material_gazebo_black/>
    </gazebo>

    <gazebo reference="crane_x7_lower_arm_revolute_part_logo_text_r_link">
      <xacro:material_gazebo_black/>
    </gazebo>

    <gazebo reference="crane_x7_gripper_base_link">
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="crane_x7_gripper_finger_a_link">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <xacro:material_gazebo_red/>
    </gazebo>

    <gazebo reference="crane_x7_gripper_finger_b_link">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <xacro:material_gazebo_red/>
    </gazebo>

  </xacro:macro>
</robot>